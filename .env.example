# Non-secret settings only. Secrets live in Vault; bootstrap credentials live in
# DATAPLAT_HOME (outside the repo). Copy to .env to override defaults.

# Where bootstrap material (unseal key, AppRole credentials) is kept, outside the repo.
# tasks.ps1 / Makefile set this automatically (%USERPROFILE%\.dataplat or ~/.dataplat).
# DATAPLAT_HOME=

# "full" runs everything; empty ("lite") leaves out Kafka Connect/Debezium (CDC).
COMPOSE_PROFILES=full

# Set to true when the console is served over HTTPS.
DATAPLAT_SECURE_COOKIES=false
